# RakshakAI dashboard backend - copy to .env.local and fill in.

# The voice bot's MongoDB: the same MONGODB_URI and CITIZEN_DB as the bot's .env.
# Give the dashboard its own database user: read on the bot collections, read/write on
# cases and case_events (case status and verdicts), read/write on dash_* collections.
MONGODB_URI=
CITIZEN_DB=voicebot

# Which bot traffic the dashboard shows by default: prod, or test (the browser test page).
# Any request can override it with ?env=prod|test.
DASHBOARD_DATA_ENV=prod

# Sign-in: one account, the police control room. Set the password with
#   npm run admin -- set-password
# which writes only its hash below (and a session secret if there is none).
DASHBOARD_ACCOUNT_NAME=Police control room
DASHBOARD_PASSWORD_HASH=
# Signs session cookies. At least 32 random characters, e.g.: openssl rand -base64 48
DASHBOARD_JWT_SECRET=
DASHBOARD_SESSION_HOURS=8


# Rough cost per call minute (telephony + model) for the cost estimate. Leave empty for none.
COST_PER_MINUTE_INR=

# Lost and found: the bot's read-only lost-and-found API (docs/bot-api-contract.md).
# Leave empty until it exists; the Lost and found page then says it isn't connected yet.
LOST_FOUND_API_URL=
BOT_API_TOKEN=
